# ═══════════════════════════════════════════════════════════════
# Seven Kingdoms Portal — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy to .env.local and fill in your values.
# Works across all deployment modes: VM, Docker, OCI Container
# Instances, and OKE (Kubernetes).
#
# Variables marked [REQUIRED] must be set for full functionality.
# Variables marked [OPTIONAL] have sensible defaults.
# ═══════════════════════════════════════════════════════════════

# ── Deployment ──────────────────────────────────────────────
# ENVIRONMENT: development | staging | production
ENVIRONMENT=production
# APP_PORT: Port the app listens on [OPTIONAL, default: 9010]
APP_PORT=9010
# APP_WORKERS: Uvicorn worker count [OPTIONAL, default: 4]
APP_WORKERS=4

# ── OCI Authentication ──────────────────────────────────────
# OCI_AUTH_MODE: auto | instance_principal | resource_principal | config_file | env_vars
#   - VM:                  instance_principal or config_file
#   - Docker (local):      config_file (mount ~/.oci)
#   - OCI Container Inst:  resource_principal
#   - OKE:                 instance_principal or resource_principal (via workload identity)
OCI_AUTH_MODE=auto
OCI_CONFIG_PROFILE=DEFAULT
OCI_CONFIG_FILE=~/.oci/config

# For env_vars auth mode (alternative to config file):
# OCI_USER_OCID=ocid1.user.oc1..
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..
# OCI_FINGERPRINT=aa:bb:cc:...
# OCI_KEY_FILE=~/.oci/oci_api_key.pem
# OCI_KEY_CONTENT=-----BEGIN PRIVATE KEY-----\n...
# OCI_REGION=eu-frankfurt-1

# ── OCI APM / OpenTelemetry [REQUIRED for tracing] ─────────
OCI_APM_DOMAIN_ID=
OCI_APM_ENDPOINT=
OCI_APM_PUBLIC_DATAKEY=
OCI_APM_PRIVATE_DATAKEY=

# ── OCI Logging [OPTIONAL] ─────────────────────────────────
OCI_LOG_GROUP_OCID=
OCI_LOG_OCID=

# ── OCI Monitoring [OPTIONAL] ──────────────────────────────
OCI_COMPARTMENT_OCID=
OCI_MONITORING_NAMESPACE=CustomAttackMetrics

# ── Portal Security ────────────────────────────────────────
# JWT secret for portal auth (intentionally weak default for demo)
PORTAL_JWT_SECRET=seven-kingdoms-secret-key-2024

# ── VM Deployment Only ──────────────────────────────────────
# SSH_KEY=/path/to/private/key
# INSTANCE_IP=10.0.2.x
# BASTION_IP=130.61.x.x

# ── Docker/Registry (for build-image.sh) ────────────────────
# REGISTRY=fra.ocir.io/your-namespace
# TAG=latest
