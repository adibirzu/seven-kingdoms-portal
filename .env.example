# ═══════════════════════════════════════════════════════════════
# Seven Kingdoms Portal — Full Platform Configuration
# ═══════════════════════════════════════════════════════════════
# Copy to .env.local and fill in your values.
# Variables marked [AUTO] are populated by deploy scripts after deployment.
# ═══════════════════════════════════════════════════════════════

# === OCI Configuration ===
OCI_PROFILE=DEFAULT
OCI_REGION=eu-frankfurt-1
OCI_AUTH_MODE=auto
OCI_CONFIG_FILE=~/.oci/config
OCI_COMPARTMENT_ID=
OCI_TENANCY_ID=
OCI_NAMESPACE=

# === Component Toggles ===
DEPLOY_GOAD=true                # Set false to skip GOAD AD lab
DEPLOY_WAF=true                 # Set false to skip WAF
DEPLOY_DNS=false                # Optional: DNS zone + records
DEPLOY_NOTIFICATIONS=false      # Optional: ONS alarm topics
APP_DEPLOY_MODE=oke             # vm | docker | oke

# === App Configuration ===
APP_PORT=9010
APP_WORKERS=4
ENVIRONMENT=production
PORTAL_JWT_SECRET=seven-kingdoms-secret-key-2024

# === SSH Keys ===
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# === Infrastructure Outputs [AUTO after C1 deploy] ===
VCN_OCID=
PUBLIC_SUBNET_OCID=
PRIVATE_SUBNET_OCID=
OKE_API_SUBNET_OCID=
APP_NSG_OCID=
LB_NSG_OCID=
PRIVATE_ROUTE_TABLE_OCID=
APP_LPG_OCID=

# === GOAD Configuration [AUTO after C2 deploy] ===
GOAD_JUMPBOX_IP=
GOAD_VCN_OCID=
GOAD_LPG_OCID=
# Standard GOAD lab IPs (rarely need override):
GOAD_DC_KINGSLANDING_IP=192.168.56.10
GOAD_DC_WINTERFELL_IP=192.168.56.11
GOAD_DC_MEEREEN_IP=192.168.56.12
GOAD_MSSQL_CASTELBLACK_HOST=192.168.56.22
GOAD_MSSQL_BRAAVOS_HOST=192.168.56.23
GOAD_MSSQL_USER=sa
GOAD_MSSQL_PASSWORD=password123!

# === Observability [AUTO after C3 deploy] ===
OCI_APM_DOMAIN_ID=
OCI_APM_ENDPOINT=
OCI_APM_PRIVATE_DATAKEY=
OCI_APM_PUBLIC_DATAKEY=
OCI_LOG_GROUP_OCID=
OCI_LOG_OCID=
OCI_MONITORING_NAMESPACE=CustomAttackMetrics

# === App Deployment Outputs [AUTO after C4 deploy] ===
APP_URL=
APP_LB_OCID=
APP_INSTANCE_IP=
BASTION_IP=

# === Docker/OCIR (for OKE/container modes) ===
OCIR_URL=
DOCKER_IMAGE_TAG=latest

# === WAF [AUTO after C5 deploy] ===
WAF_OCID=
WAF_POLICY_OCID=

# === DNS (optional) ===
DNS_ZONE_NAME=
DNS_HOSTNAME=
